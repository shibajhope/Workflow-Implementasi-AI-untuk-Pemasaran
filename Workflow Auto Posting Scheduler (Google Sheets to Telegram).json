    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n  \n  // Ambil data dan hilangkan spasi tambahan (trim) agar tidak error\n  const status = row['Status'] ? row['Status'].toString().trim() : '';\n  const dateStr = row['Scheduled Date'] ? row['Scheduled Date'].toString().trim() : '';\n  const timeStr = row['Scheduled Time'] ? row['Scheduled Time'].toString().trim() : '';\n\n  if (status === 'Pending' && dateStr && timeStr) {\n    try {\n      // Pecah tanggal (asumsi format DD/MM/YYYY)\n      const parts = dateStr.split('/');\n      if (parts.length !== 3) continue;\n\n      const day = parts[0].padStart(2, '0');\n      const month = parts[1].padStart(2, '0');\n      const year = parts[2];\n\n      // Pastikan format waktu HH:mm:ss\n      // Jika di Sheets cuma 9:30, kita ubah jadi 09:30:00\n      const timeParts = timeStr.split(':');\n      const hour = timeParts[0].padStart(2, '0');\n      const min = timeParts[1] ? timeParts[1].padStart(2, '0') : '00';\n      const sec = timeParts[2] ? timeParts[2].padStart(2, '0') : '00';\n\n      const formattedDate = `${year}-${month}-${day}T${hour}:${min}:${sec}`;\n      const scheduledTime = new Date(formattedDate);\n\n      // Cek apakah waktu sekarang sudah melewati jadwal\n      if (now >= scheduledTime) {\n        postsToSend.push({ json: row });\n      }\n    } catch (e) {\n      // Jika ada satu baris error, lanjut ke baris berikutnya\n      continue;\n    }\n  }\n}\n\nreturn postsToSend;"
      },
